+/** Adjacent-pair Stage 3D diagnostic. No result growth, image validation,
+ * cache scan or game-state callback occurs between the two members of a pair. */
+CabViewPairedProbe ProbeCabViewPaired(const Rect &r, const CabViewCamera &camera, const std::function<bool()> &frozen_check)
+{
+	using Clock = std::chrono::steady_clock;
+	CabViewPairedProbe result;
+	Renderer renderer;
+	CabViewCamera draw_camera = camera;
+	const size_t pixel_count = static_cast<size_t>(r.Width()) * r.Height();
+	auto *output = static_cast<const Colour *>(_cur_dpi->dst_ptr);
+	std::vector<Colour> reference(pixel_count), first_image(pixel_count), second_image(pixel_count);
+	for (std::vector<Colour> &image : result.representative_images) image.resize(pixel_count);
+	/* Fault in every diagnostic image page before warmups or measured pairs. */
+	const Colour touch(1, 2, 3);
+	std::fill(reference.begin(), reference.end(), touch);
+	std::fill(first_image.begin(), first_image.end(), touch);
+	std::fill(second_image.begin(), second_image.end(), touch);
+	for (std::vector<Colour> &image : result.representative_images) std::fill(image.begin(), image.end(), touch);
+	std::array<bool, 4> representative_written{};
+	uint32_t frame_id = 1;
+	draw_camera.effect_mode = CabViewEffectMode::Off;
+	for (int i = 0; i < 20; ++i) renderer.Draw(r, draw_camera, frame_id++, 0);
+	draw_camera.effect_mode = CabViewEffectMode::Reduced;
+	for (int i = 0; i < 20; ++i) renderer.Draw(r, draw_camera, frame_id++, 0);
+	std::copy_n(output, pixel_count, reference.begin());
+	const CabViewFrameStats geometry = renderer.GetLastFrameStats();
+	result.warm_cache = renderer.GetCacheStats();
+	static constexpr std::array<CabViewPairLabel, 4> EVEN = {
+		CabViewPairLabel::OR, CabViewPairLabel::AB, CabViewPairLabel::RO, CabViewPairLabel::BA};
+	const auto started = Clock::now();
+	uint32_t previous_frame_id = 0;
+	result.unique_measured_frame_ids = true;
+	for (uint32_t cycle = 0; cycle < 50; ++cycle) {
+		for (uint8_t position = 0; position < 4; ++position) {
+			const CabViewPairLabel label = EVEN[cycle % 2 == 0 ? position : 3 - position];
+			CabViewPairedPair &pair = result.pairs[cycle * 4 + position];
+			pair.cycle = cycle;
+			pair.position = position;
+			pair.label = label;
+			const std::array<char, 2> names = label == CabViewPairLabel::OR ? std::array{'O', 'R'} :
+				label == CabViewPairLabel::AB ? std::array{'A', 'B'} :
+				label == CabViewPairLabel::RO ? std::array{'R', 'O'} : std::array{'B', 'A'};
+			for (int arm = 0; arm < 2; ++arm) {
+				CabViewPairedArm &member = pair.arms[arm];
+				member.label = names[arm];
+				member.actual_mode = names[arm] == 'R' ? CabViewEffectMode::Reduced : CabViewEffectMode::Off;
+				draw_camera.effect_mode = member.actual_mode;
+				const auto begin = Clock::now();
+				const uint64_t relative_start_us = std::chrono::duration_cast<std::chrono::microseconds>(begin - started).count();
+				renderer.Draw(r, draw_camera, frame_id++, 0);
+				const auto end = Clock::now();
+				member.sample = {renderer.GetLastFrameStats(), relative_start_us,
+					static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(end - begin).count())};
+				result.unique_measured_frame_ids &= member.sample.frame.frame_id > previous_frame_id;
+				previous_frame_id = member.sample.frame.frame_id;
+				/* Both arms copy into preallocated storage after their timer stops.
+				 * Between members there is no validation, growth or state query. */
+				std::copy_n(output, pixel_count, arm == 0 ? first_image.begin() : second_image.begin());
+			}
+			const auto image_equal = [&](const Colour *image, const std::vector<Colour> &expected) {
+				return std::equal(image, image + pixel_count, expected.begin());
+			};
+			pair.first_image_exact = image_equal(first_image.data(), reference);
+			pair.second_image_exact = image_equal(second_image.data(), reference);
+			pair.pair_images_equal = first_image == second_image;
+			for (int arm = 0; arm < 2; ++arm) {
+				const CabViewFrameStats &s = pair.arms[arm].sample.frame;
+				const bool same = s.rendered && !s.cache_hit && s.scale == 1.0f &&
+					s.internal_width == r.Width() && s.internal_height == r.Height() &&
+					s.visible_tiles == geometry.visible_tiles && s.triangles == geometry.triangles &&
+					s.threads == geometry.threads;
+				if (arm == 0) pair.first_geometry_exact = same;
+				else pair.second_geometry_exact = same;
+			}
+			const size_t index = static_cast<size_t>(label);
+			if (!representative_written[index]) {
+				std::copy_n(second_image.begin(), pixel_count, result.representative_images[index].begin());
+				representative_written[index] = true;
+			}
+			++result.completed_pairs;
+		}
+		CabViewPairedCycle &check = result.cycles[cycle];
+		check.cache = renderer.GetCacheStats();
+		check.cache_unchanged = check.cache == result.warm_cache;
+		check.frozen_state_unchanged = frozen_check();
+		++result.completed_cycles;
+		if (!check.cache_unchanged || !check.frozen_state_unchanged) break;
+	}
+	return result;
+}
