+	SubmitFileQuery(window, WID_BPL_IMPORT, invalid_enum.string());
+	CHECK(BlueprintManager::GetBlueprints().size() == before);
+	CHECK(Status(window).find("Import failed:") == 0);
+	SubmitFileQuery(window, WID_BPL_EXPORT, malformed.string());
