+	CHECK_FALSE(BlueprintManager::RescanLibrary(&error));
+	CHECK(error.find("large.json") != std::string::npos);
+	CHECK(BlueprintManager::GetBlueprints().size() == BlueprintManager::GetBuiltinCount());
+}
