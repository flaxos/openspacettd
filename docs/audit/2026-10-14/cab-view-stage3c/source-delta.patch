+/** Private, non-mutating eight-block scheduler diagnostic. The output scope is
+ * supplied by the native test, so no live renderer or GUI clock is touched. */
+CabViewCounterbalancedProbe ProbeCabViewCounterbalanced(const Rect &r, const CabViewCamera &camera, const std::function<bool()> &frozen_check)
+{
+	using Clock = std::chrono::steady_clock;
+	auto process_counters = [] {
+		CabViewProcessCounters counters;
+#if defined(__unix__) || defined(__APPLE__)
+		rusage use{};
+		if (getrusage(RUSAGE_SELF, &use) == 0) {
+			counters.supported = true;
+			counters.user_cpu_us = static_cast<uint64_t>(use.ru_utime.tv_sec) * 1000000 + use.ru_utime.tv_usec;
+			counters.system_cpu_us = static_cast<uint64_t>(use.ru_stime.tv_sec) * 1000000 + use.ru_stime.tv_usec;
+			counters.voluntary_context_switches = use.ru_nvcsw;
+			counters.involuntary_context_switches = use.ru_nivcsw;
+		}
+#endif
+		return counters;
+	};
+	CabViewCounterbalancedProbe result;
+	Renderer off, reduced;
+	CabViewCamera off_camera = camera, reduced_camera = camera;
+	off_camera.effect_mode = CabViewEffectMode::Off;
+	reduced_camera.effect_mode = CabViewEffectMode::Reduced;
+	uint32_t frame_id = 1;
+	const size_t pixel_count = static_cast<size_t>(r.Width()) * r.Height();
+	auto *output = static_cast<const Colour *>(_cur_dpi->dst_ptr);
+	std::array<std::vector<Colour>, 2> reference_images;
+	std::array<CabViewCacheStats, 2> reference_caches;
+	for (int mode = 0; mode < 2; ++mode) {
+		Renderer &renderer = mode == 0 ? off : reduced;
+		const CabViewCamera &current_camera = mode == 0 ? off_camera : reduced_camera;
+		for (int i = 0; i < 20; ++i) renderer.Draw(r, current_camera, frame_id++, 0);
+		reference_images[mode].assign(output, output + pixel_count);
+		reference_caches[mode] = renderer.GetCacheStats();
+	}
+	const auto start = Clock::now();
+	static constexpr std::array<int, 8> ORDER = {0, 1, 1, 0, 1, 0, 0, 1};
+	result.blocks.reserve(ORDER.size());
+	std::optional<CabViewFrameStats> geometry;
+	for (int mode : ORDER) {
+		Renderer &renderer = mode == 0 ? off : reduced;
+		const CabViewCamera &current_camera = mode == 0 ? off_camera : reduced_camera;
+		CabViewCounterbalancedBlock block;
+		block.mode = current_camera.effect_mode;
+		block.before = process_counters();
+		block.relative_start_us = std::chrono::duration_cast<std::chrono::microseconds>(Clock::now() - start).count();
+		block.exact_same_mode_image = true;
+		block.exact_geometry = true;
+		block.samples.reserve(25);
+		for (int i = 0; i < 25; ++i) {
+			const auto begin = Clock::now();
+			const uint64_t relative_start_us = std::chrono::duration_cast<std::chrono::microseconds>(begin - start).count();
+			renderer.Draw(r, current_camera, frame_id++, 0);
+			const auto end = Clock::now();
+			const CabViewFrameStats frame = renderer.GetLastFrameStats();
+			block.samples.push_back({frame, relative_start_us,
+				static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(end - begin).count())});
+			block.exact_same_mode_image &= std::equal(output, output + pixel_count, reference_images[mode].begin());
+			if (!geometry.has_value()) geometry = frame;
+			const bool same_geometry = frame.rendered && !frame.cache_hit && frame.scale == 1.0f &&
+				frame.internal_width == r.Width() && frame.internal_height == r.Height() &&
+				frame.visible_tiles == geometry->visible_tiles && frame.triangles == geometry->triangles && frame.threads == geometry->threads;
+			block.exact_geometry &= same_geometry;
+			result.exact_cross_mode_geometry = result.blocks.empty() && i == 0 ? same_geometry : result.exact_cross_mode_geometry && same_geometry;
+		}
+		block.end_pixels.assign(output, output + pixel_count);
+		block.cache = renderer.GetCacheStats();
+		block.exact_same_mode_cache = block.cache == reference_caches[mode];
+		block.after = process_counters();
+		block.frozen_state_unchanged = frozen_check();
+		result.blocks.push_back(std::move(block));
+		if (!result.blocks.back().frozen_state_unchanged) break;
+	}
+	result.exact_cross_mode_scene_cache = off.GetCacheStats() == reduced.GetCacheStats();
+	result.exact_cross_mode_image = reference_images[0] == reference_images[1];
+	return result;
+}
