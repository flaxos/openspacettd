+/** Inspect only the caller's already-world-masked vehicle sequence. These are
+ * source contributions surviving later source layers, not proof of a changed
+ * palette epoch or of a visible cab pixel after projection. */
+CabViewAnimatedSequenceProbe Renderer::ProbeAnimatedSequence(const VehicleSpriteSeq &seq, PaletteID default_pal, bool crashed)
+{
+	CabViewAnimatedSequenceProbe result;
+	if (seq.count > seq.seq.size()) { result.complete = false; result.rejected_oversize = true; return result; }
+	struct Layer { const RawSprite *raw = nullptr; const uint8_t *remap = nullptr; bool black = false; };
+	std::array<Layer, 8> sources{};
+	int64_t left = INT64_MAX, top = INT64_MAX, right = INT64_MIN, bottom = INT64_MIN;
+	for (uint i = 0; i < seq.count; ++i) {
+		const SpriteID image = seq.seq[i].sprite;
+		const PaletteID pal = (crashed || seq.seq[i].pal == 0) ? default_pal : seq.seq[i].pal;
+		CabViewAnimatedLayerProbe &out = result.layers.emplace_back();
+		out.sprite = image;
+		out.palette = pal;
+		out.black = pal == PALETTE_ALL_BLACK;
+		if (HasBit(image, PALETTE_MODIFIER_TRANSPARENT)) {
+			out.skipped_destination_dependent = true; result.complete = false; continue;
+		}
+		if (HasBit(pal, PALETTE_TEXT_RECOLOUR)) {
+			out.skipped_text_recolour = true; result.complete = false; continue;
+		}
+		const RawSprite &raw = this->GetRawSprite(image & SPRITE_MASK);
+		out.left = raw.x_offs; out.top = raw.y_offs; out.width = raw.width; out.height = raw.height;
+		if (raw.width <= 0 || raw.height <= 0 || raw.pixels.empty() ||
+			static_cast<int64_t>(raw.width) * raw.height > static_cast<int64_t>(raw.pixels.size())) {
+			out.raw_missing = true; result.complete = false; continue;
+		}
+		left = std::min(left, static_cast<int64_t>(raw.x_offs));
+		top = std::min(top, static_cast<int64_t>(raw.y_offs));
+		right = std::max(right, static_cast<int64_t>(raw.x_offs) + raw.width);
+		bottom = std::max(bottom, static_cast<int64_t>(raw.y_offs) + raw.height);
+		sources[i] = {&raw, pal != PAL_NONE && !out.black ? GetNonSprite(GB(pal, 0, PALETTE_WIDTH), SpriteType::Recolour) + 1 : nullptr, out.black};
+	}
+	if (left == INT64_MAX) return result;
+	if (!CabViewVehicleUnionSupported(left, top, right, bottom)) {
+		result.complete = false; result.rejected_oversize = true; return result;
+	}
+	const int64_t width = right - left;
+	std::vector<float> later_transmission(static_cast<size_t>(width * (bottom - top)), 1.0f);
+	for (size_t layer = seq.count; layer-- > 0;) {
+		const Layer &source = sources[layer];
+		if (source.raw == nullptr) continue;
+		CabViewAnimatedLayerProbe &out = result.layers[layer];
+		for (int y = 0; y < source.raw->height; ++y) {
+			for (int x = 0; x < source.raw->width; ++x) {
+				const SpriteLoader::CommonPixel &p = source.raw->pixels[static_cast<size_t>(y) * source.raw->width + x];
+				if (p.a == 0) continue;
+				const size_t at = static_cast<size_t>(source.raw->y_offs + y - top) * width + (source.raw->x_offs + x - left);
+				if (p.m >= PALETTE_ANIM_START && p.m < PALETTE_ANIM_START + PALETTE_ANIM_SIZE) ++out.raw_animated_pixels;
+				if (source.black) { later_transmission[at] = 0; continue; }
+				float opacity = p.a / 255.0f;
+				if (p.m != 0) {
+					const uint8_t index = source.remap != nullptr ? source.remap[p.m] : p.m;
+					if (source.remap != nullptr && index == 0) { ++out.zero_remap_pixels; continue; }
+					if (index >= PALETTE_ANIM_START && index < PALETTE_ANIM_START + PALETTE_ANIM_SIZE) {
+						const Colour adjusted = AdjustBrightness(_cur_palette.palette[index], GetColourBrightness(Colour(p.r, p.g, p.b)));
+						if (adjusted.r == 0 && adjusted.g == 0 && adjusted.b == 0) ++out.brightness_zero_pixels;
+						if (later_transmission[at] > 0) {
+							++out.eligible_animated_pixels;
+							++out.eligible_slot_counts[index - PALETTE_ANIM_START];
+						}
+					}
+				}
+				later_transmission[at] *= 1.0f - opacity;
+			}
+		}
+		result.raw_animated_pixels += out.raw_animated_pixels;
+		result.eligible_animated_pixels += out.eligible_animated_pixels;
+	}
+	return result;
 }
 
