+/** Build the unfiltered union of every supported vehicle layer. The caller
+ * applies FinishTexture only after a probe can inspect the actual blend. */
+VehicleCanvas Renderer::BuildVehicleCanvas(const VehicleSpriteSeq &seq, PaletteID default_pal, bool crashed)
+{
+	VehicleCanvas canvas;
+	/* A rejected or all-destination-dependent sequence has no union and must
+	 * never be mistaken for the GroundTexture default one-pixel picture. */
+	canvas.texture.levels[0].width = canvas.texture.levels[0].height = 0;
+	canvas.texture.levels[0].pixels.clear();
+	if (seq.count > seq.seq.size()) { canvas.rejected_oversize = true; return canvas; }
+	struct Layer { const RawSprite *raw; PaletteID pal; };
+	std::array<Layer, 8> layers{};
+	size_t count = 0;
+	int64_t left = INT64_MAX, top = INT64_MAX, right = INT64_MIN, bottom = INT64_MIN;
+	for (uint i = 0; i < seq.count; ++i) {
+		const SpriteID image = seq.seq[i].sprite;
+		const PaletteID pal = (crashed || seq.seq[i].pal == 0) ? default_pal : seq.seq[i].pal;
+		/* A transparent modifier changes the framebuffer already behind this
+		 * sprite. A source-only texture cannot reproduce that operation. */
+		if (HasBit(image, PALETTE_MODIFIER_TRANSPARENT)) { ++canvas.skipped_destination_layers; continue; }
+		if (HasBit(pal, PALETTE_TEXT_RECOLOUR)) { ++canvas.skipped_text_layers; continue; }
+		const RawSprite &raw = this->GetRawSprite(image & SPRITE_MASK);
+		if (raw.width <= 0 || raw.height <= 0 || raw.pixels.empty() ||
+			static_cast<int64_t>(raw.width) * raw.height > static_cast<int64_t>(raw.pixels.size())) continue;
+		left = std::min(left, static_cast<int64_t>(raw.x_offs));
+		top = std::min(top, static_cast<int64_t>(raw.y_offs));
+		right = std::max(right, static_cast<int64_t>(raw.x_offs) + raw.width);
+		bottom = std::max(bottom, static_cast<int64_t>(raw.y_offs) + raw.height);
+		layers[count++] = {&raw, pal};
+	}
+	if (count == 0) return canvas;
+	if (!CabViewVehicleUnionSupported(left, top, right, bottom)) {
+		canvas.rejected_oversize = true;
+		return canvas;
+	}
+	const int64_t width = right - left, height = bottom - top;
+	GroundTexture &texture = canvas.texture;
+	texture.left = static_cast<int>(left);
+	texture.top = static_cast<int>(top);
+	Picture &pic = texture.levels[0];
+	pic.width = static_cast<int>(width);
+	pic.height = static_cast<int>(height);
+	pic.pixels.assign(static_cast<size_t>(width * height), {0, 0, 0});
+	canvas.alpha.assign(pic.pixels.size(), 0.0f);
+	for (size_t i = 0; i < count; ++i) {
+		const RawSprite &raw = *layers[i].raw;
+		PaintVehicleSprite(pic, canvas.alpha, raw, layers[i].pal,
+			static_cast<int>(static_cast<int64_t>(raw.x_offs) - left),
+			static_cast<int>(static_cast<int64_t>(raw.y_offs) - top));
+	}
+	return canvas;
+}
