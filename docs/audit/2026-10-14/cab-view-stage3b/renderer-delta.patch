+/** Cache identity includes the entire ordered sequence and every effective
+ * palette. Cache clearing remains at frame start, before triangles reference
+ * their textures; this function never evicts while building a scene. */
+const GroundTexture &Renderer::GetVehicleTexture(const VehicleSpriteSeq &seq, PaletteID default_pal, bool crashed, bool widen)
+{
+	this->key.clear();
+	this->key.push_back(VEHICLE_TEXTURE_KEY);
+	this->key.push_back(static_cast<int32_t>(seq.count));
+	this->key.push_back(widen ? 1 : 0);
+	this->key.push_back(crashed ? 1 : 0);
+	for (uint i = 0; i < std::min<size_t>(seq.count, seq.seq.size()); ++i) {
+		this->key.push_back(static_cast<int32_t>(seq.seq[i].sprite));
+		this->key.push_back(static_cast<int32_t>((crashed || seq.seq[i].pal == 0) ? default_pal : seq.seq[i].pal));
+	}
+	auto found = this->textures.find(this->key);
+	if (found != this->textures.end()) return found->second;
+	VehicleCanvas canvas = this->BuildVehicleCanvas(seq, default_pal, crashed);
+	GroundTexture &texture = this->textures[this->key];
+	texture = std::move(canvas.texture);
+	if (!canvas.alpha.empty()) FinishTexture(texture, std::move(canvas.alpha), 4, true, {0, 0}, widen);
+	return texture;
+}
