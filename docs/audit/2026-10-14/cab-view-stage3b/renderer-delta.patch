+CabViewVehicleTextureProfile Renderer::ProfileVehicleTexture(const VehicleSpriteSeq &seq, PaletteID default_pal, bool crashed, bool widen, uint32_t warm_lookups)
+{
+	using Clock = std::chrono::steady_clock;
+	auto ns = [](auto elapsed) { return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(elapsed).count()); };
+	CabViewVehicleTextureProfile profile;
+	auto cold_start = Clock::now();
+	const GroundTexture *cold = &this->GetVehicleTexture(seq, default_pal, crashed, widen);
+	profile.cold_build_ns = ns(Clock::now() - cold_start);
+	profile.cold_level0_pixels = cold->levels[0].pixels.size();
+	profile.cache_after_cold = this->GetCacheStats();
+	for (int i = 0; i < 20; ++i) (void)this->GetVehicleTexture(seq, default_pal, crashed, widen);
+	const auto warm_start = Clock::now();
+	size_t observed_pixels = 0;
+	bool stable = true;
+	for (uint32_t i = 0; i < warm_lookups; ++i) {
+		const GroundTexture *hit = &this->GetVehicleTexture(seq, default_pal, crashed, widen);
+		observed_pixels += hit->levels[0].pixels.size();
+		stable &= hit == cold;
+	}
+	profile.warm_lookup_total_ns = ns(Clock::now() - warm_start);
+	profile.warm_lookups = warm_lookups;
+	profile.warm_texture_stable = stable && observed_pixels == profile.cold_level0_pixels * warm_lookups;
+	profile.cache = this->GetCacheStats(); // Deep scan belongs outside both timed sections.
+	profile.composition = this->ProbeVehicleComposite(seq, default_pal, crashed);
+	return profile;
+}
