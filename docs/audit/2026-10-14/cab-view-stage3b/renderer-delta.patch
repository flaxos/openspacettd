+/** Draw one normal vehicle layer into a transparent, premultiplied picture.
+ * Native ColourRemap skips remap index zero and keeps the source pixel's
+ * brightness; the shared terrain painter deliberately has different rules. */
+static void PaintVehicleSprite(Picture &pic, std::vector<float> &alpha, const RawSprite &raw, PaletteID pal, int ox, int oy,
+	const uint8_t *synthetic_remap = nullptr)
+{
+	const bool black = pal == PALETTE_ALL_BLACK;
+	const bool crashed = pal == PALETTE_CRASH;
+	const uint8_t *remap = (pal != PAL_NONE && !black) ? (synthetic_remap != nullptr ? synthetic_remap :
+		GetNonSprite(GB(pal, 0, PALETTE_WIDTH), SpriteType::Recolour) + 1) : nullptr;
+	for (int y = 0; y < raw.height; ++y) {
+		for (int x = 0; x < raw.width; ++x) {
+			const SpriteLoader::CommonPixel &p = raw.pixels[static_cast<size_t>(y) * raw.width + x];
+			if (p.a == 0) continue;
+			RGB colour{static_cast<float>(p.r), static_cast<float>(p.g), static_cast<float>(p.b)};
+			float opacity = p.a / 255.0f;
+			if (black) {
+				colour = {0, 0, 0};
+				opacity = 1.0f; // Native BlackRemap writes black wherever source alpha is nonzero.
+			} else if (p.m != 0) {
+				const uint8_t index = remap != nullptr ? remap[p.m] : p.m;
+				if (remap != nullptr && index == 0) continue;
+				const Colour adjusted = AdjustBrightness(_cur_palette.palette[index], GetColourBrightness(Colour(p.r, p.g, p.b)));
+				colour = {static_cast<float>(adjusted.r), static_cast<float>(adjusted.g), static_cast<float>(adjusted.b)};
+			} else if (crashed && p.m == 0) {
+				const uint8_t grey = static_cast<uint8_t>((p.r * 13063 + p.g * 25647 + p.b * 4981) / 65536);
+				colour = {static_cast<float>(grey), static_cast<float>(grey), static_cast<float>(grey)};
+			}
+			const size_t at = static_cast<size_t>(oy + y) * pic.width + ox + x;
+			pic.pixels[at] = pic.pixels[at] * (1.0f - opacity) + colour * opacity;
+			alpha[at] = opacity + alpha[at] * (1.0f - opacity);
+		}
+	}
+}
