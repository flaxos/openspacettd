+	result.after_first = this->GetCacheStats();
+	result.repeated_key_reused = original == &this->GetVehicleTexture(first, default_pal, crashed, first_widen);
+	result.after_repeat = this->GetCacheStats();
+	result.variant_key_distinct = original != &this->GetVehicleTexture(variant, default_pal, crashed, variant_widen);
+	result.after_variant = this->GetCacheStats();
+	return result;
 }
 
