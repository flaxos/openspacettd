+bool CabViewVehicleUnionSupported(int64_t left, int64_t top, int64_t right, int64_t bottom)
+{
+	if (right <= left || bottom <= top) return false;
+	const uint64_t width = static_cast<uint64_t>(right) - static_cast<uint64_t>(left);
+	const uint64_t height = static_cast<uint64_t>(bottom) - static_cast<uint64_t>(top);
+	return width <= MAX_VEHICLE_TEXTURE_AXIS && height <= MAX_VEHICLE_TEXTURE_AXIS &&
+		width * height <= MAX_VEHICLE_TEXTURE_PIXELS;
+}
