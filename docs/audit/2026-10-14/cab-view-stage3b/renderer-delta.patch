+CabViewVehicleCompositeProbe Renderer::ProbeVehicleComposite(const VehicleSpriteSeq &seq, PaletteID default_pal, bool crashed)
+{
+	VehicleCanvas canvas = this->BuildVehicleCanvas(seq, default_pal, crashed);
+	const Picture &pic = canvas.texture.levels[0];
+	CabViewVehicleCompositeProbe probe;
+	probe.left = canvas.texture.left;
+	probe.top = canvas.texture.top;
+	probe.width = pic.width;
+	probe.height = pic.height;
+	probe.skipped_destination_layers = canvas.skipped_destination_layers;
+	probe.skipped_text_layers = canvas.skipped_text_layers;
+	probe.rejected_oversize = canvas.rejected_oversize;
+	if (canvas.alpha.empty()) { probe.width = probe.height = 0; return probe; }
+	probe.pixels.reserve(pic.pixels.size());
+	for (size_t i = 0; i < pic.pixels.size(); ++i) {
+		const RGB &c = pic.pixels[i];
+		probe.pixels.push_back({c.r, c.g, c.b, canvas.alpha[i]});
+	}
+	return probe;
+}
