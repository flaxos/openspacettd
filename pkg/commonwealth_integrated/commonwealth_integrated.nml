grf {
	grfid: "OST\01";
	name: string(STR_GRF_NAME);
	desc: string(STR_GRF_DESC);
	version: 5;
	min_compatible_version: 5;
}

cargotable {
	SILC, // Stone & Slag / Silicates
	IRON, // Iron Ore
	STEL, // Structural Steel
	COPR, // Copper Ore
	WIRE, // Conductive Wiring & Coils
	SAND, // Silica Sand & Quartz
	CHIP, // Silicon Wafers & Chips
	RARE, // Rare Earth Minerals
	ALLO, // Superalloys & Superconductors
	POLY, // Synthetic Polymers & Composites
	BCRY, // Blank Data Crystals
	QCRY, // Enriched Quantum Crystals
	CCRY, BALL, SIGE, MGLA, MACH, OIL_, GRAI, FOOD // Encrypted Consumer Crystals
}

/* ====================================================================
 * CARGO DEFINITIONS (Pipelines A, B, C, D)
 * ==================================================================== */

/* Pipeline A: Structural & Track Infrastructure */
item(FEAT_CARGOS, cargo_silc, 0x10) {
	property {
		is_freight: 1;
		cargo_label: "SILC";
		number: 16;
		type_name: string(STR_CARGO_NAME_SILC);
		unit_name: string(STR_CARGO_NAME_SILC);
		units_of_cargo: 0x0050; // Native weight units, including player unit conversion.
		items_of_cargo: string(STR_CARGO_UNIT_SILC);
		type_abbreviation: string(STR_CARGO_ABBR_SILC);
		sprite: 0x1AC0;
		weight: 1 ton;
		price_factor: 120;
		penalty_lowerbound: 15;
		single_penalty_length: 60;
		cargo_classes: bitmask(CC_BULK, CC_NON_POTABLE);
		town_growth_effect: TOWNGROWTH_NONE;
	}
}

