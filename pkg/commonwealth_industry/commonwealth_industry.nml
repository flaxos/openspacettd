grf {
	grfid: "OST\x01";
	name: string(STR_GRF_NAME);
	desc: string(STR_GRF_DESC);
	version: 1;
	min_compatible_version: 1;
}

cargotable {
	SILC, // Stone & Slag / Silicates
	IRON, // Iron Ore
	STEL, // Structural Steel
	COPR, // Copper Ore
	WIRE, // Conductive Wiring & Coils
	SAND, // Silica Sand & Quartz
	CHIP, // Silicon Wafers & Chips
	RARE, // Rare Earth Minerals
	ALLO, // Superalloys & Superconductors
	POLY, // Synthetic Polymers & Composites
	BCRY, // Blank Data Crystals
	QCRY, // Enriched Quantum Crystals
	CCRY  // Encrypted Consumer Crystals
}

/* ====================================================================
 * CARGO DEFINITIONS (Pipelines A, B, C, D)
 * ==================================================================== */

/* Pipeline A: Structural & Track Infrastructure */
item(FEAT_CARGOS, cargo_silc, 0x01) {
	property {
		number: 16;
		type_name: string(STR_CARGO_NAME_SILC);
		unit_name: string(STR_CARGO_UNIT_SILC);
		type_abbreviation: string(STR_CARGO_ABBR_SILC);
		sprite: 0x1AC0;
		weight: 16;
		payment_multiplier: 120;
		transit_days_1: 15;
		transit_days_2: 60;
		cargo_classes: bitmask(CC_BULK, CC_NON_POOTABLE);
		town_growth_effect: TOWNGROWTH_NONE;
	}
}

