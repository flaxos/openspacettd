/* Pipeline A: Structural */
item(FEAT_INDUSTRIES, ind_quarry, 0x10) {
	property {
		substitute: 0x00;
		name: string(STR_IND_NAME_QUARRY);
		life_type: IND_LIFE_EXTRACTIVE;
		prod_cargo_types: [SILC];
		prod_multiplier: [18];
	}
}

item(FEAT_INDUSTRIES, ind_crusher, 0x11) {
	property {
		substitute: 0x02;
		name: string(STR_IND_NAME_CRUSHER);
		life_type: IND_LIFE_PROCESSING;
		accept_cargo_types: [SILC];
