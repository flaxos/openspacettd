/* ====================================================================
 * INDUSTRY DEFINITIONS
 * ==================================================================== */

/* Pipeline A: Structural */
item(FEAT_INDUSTRIES, ind_quarry, 0x10) {
	property {
		substitute: 0x00;
		name: string(STR_IND_NAME_QUARRY);
		life_type: IND_LIFE_TYPE_EXTRACTIVE;
		cargo_types: [produce_cargo("SILC", 18)];
	}
}

item(FEAT_INDUSTRIES, ind_crusher, 0x11) {
	property {
		substitute: 0x02;
		name: string(STR_IND_NAME_CRUSHER);
		life_type: IND_LIFE_TYPE_PROCESSING;
		cargo_types: [accept_cargo("SILC"), produce_cargo("SILC", 16)];
	}
}

