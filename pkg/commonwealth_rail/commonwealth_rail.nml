grf {
	grfid: "OST\02";
	name: string(STR_GRF_NAME);
	desc: string(STR_GRF_DESC);
	version: 2;
	min_compatible_version: 2;
}

cargotable {
	PASS, VALU, IORE, STEL, GOOD, OIL_,
	SILC, IRON, COPR, WIRE, SAND, CHIP, RARE, ALLO, POLY, BCRY, QCRY, CCRY
}

railtypetable {
	RAIL,
	ELRL,
	MGLV
}

/* ====================================================================
 * CST LOCOMOTIVE FAMILIES (TECH TREE GATED)
 * ==================================================================== */

/* CST Pioneer 0-6-0 'Surveyor' (Steam - Baseline Unlocked) */
item(FEAT_TRAINS, cst_pioneer_steam, 0x20) {
	property {
		name: string(STR_NAME_CST_PIONEER);
		climates_available: ALL_CLIMATES;
		introduction_date: date(0, 1, 1);
		model_life: 255;
		vehicle_life: 25;
		reliability_decay: 20;
		refittable_cargo_classes: bitmask(CC_PASSENGERS);
		cargo_allow_refit: [PASS];
		loading_speed: 5;
		cost_factor: 15;
		running_cost_factor: 18;
		speed: 72 km/h;
		power: 600 hp;
		weight: 45 ton;
		tractive_effort_coefficient: 0.22;
		engine_class: ENGINE_CLASS_STEAM;
		track_type: RAIL;
	}
}

